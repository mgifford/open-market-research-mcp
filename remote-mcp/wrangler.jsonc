{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-market-research-mcp",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_MCP_ENABLED": "false"
  },
  "observability": {
    "enabled": false
  }
}
