  "research_question_templates": [
    {
      "category": "government-reuse",
      "text": "Are there existing federal, state, or local government systems that could be reused or adapted?"
    },
    {
      "category": "accessibility",
      "text": "Which Section 508 requirements apply, and what product- and version-specific ACR evidence exists?"
    },
    {
      "category": "pricing",
      "text": "What comparable awards, ceiling rates, or wage benchmarks are available, and what do they not tell us?"
    },
    {
      "category": "supplier-capabilities",
      "text": "Which suppliers or communities have demonstrated the relevant capability, and what evidence supports that?"
    },
