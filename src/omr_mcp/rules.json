  "questions": [
    {
      "id": "source-url",
      "when": {
        "type": "empty",
        "field": "url"
      },
      "text": "Identify an authoritative product or repository source for this option."
    },
    {
      "id": "version",
      "when": {
        "type": "empty",
        "field": "version"
      },
      "text": "Confirm the exact product release and configuration being evaluated."
    },
    {
      "id": "acr-url",
      "when": {
        "type": "empty",
        "field": "acr_url"
      },
      "text": "Request a current, product- and version-matched Accessibility Conformance Report (ACR)."
    },
    {
      "id": "acr-date",
      "when": {
        "type": "empty",
        "field": "acr_date"
      },
      "text": "Confirm the ACR date and the scope of the evaluation."
    },
    {
      "id": "claim-supports",
      "when": {
        "type": "claim",
        "value": "supports"
      },
      "text": "Vendor-reported support is not independently verified; request supporting test evidence."
    },
    {
      "id": "claim-partially-supports",
      "when": {
        "type": "claim",
        "value": "partially-supports"
      },
      "text": "Ask which tasks are affected, the impact on users, and the remediation plan."
    },
    {
      "id": "claim-does-not-support",
      "when": {
        "type": "claim",
        "value": "does-not-support"
      },
      "text": "Document reported barriers, affected tasks, and feasible alternatives; obtain specialist review."
    },
    {
      "id": "claim-not-evaluated",
      "when": {
        "type": "claim",
        "value": "not-evaluated"
      },
      "text": "Not evaluated means evidence is missing, not that the option has failed."
    },
    {
      "id": "claim-unknown",
      "when": {
        "type": "claim",
        "value": "unknown"
      },
      "text": "The accessibility claim is unknown; obtain structured evidence before comparing accessibility."
    },
    {
      "id": "evaluation-none",
      "when": {
        "type": "evaluation",
        "value": "none"
      },
      "text": "Plan independent evaluation of critical user tasks with appropriate assistive technology."
    },
    {
      "id": "evaluation-planned",
      "when": {
        "type": "evaluation",
        "value": "planned"
      },
      "text": "Obtain the evaluation plan, methods, coverage, and completion date."
    },
    {
      "id": "evaluation-completed",
      "when": {
        "type": "evaluation",
        "value": "completed"
      },
      "text": "Locate the actual independent evaluation report; verify its scope, date, and findings."
    },
    {
      "id": "exceptions",
      "when": {
        "type": "always"
      },
      "text": "Determine whether agency Section 508 reviewers must assess any possible exceptions."
    }
  ],
  "messages": {
